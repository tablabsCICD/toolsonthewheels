# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---- Server ----
PORT=3000
NODE_ENV=production
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,https://toolsonthewheels.com,https://www.toolsonthewheels.com

# ---- Business ----
# Where owner notification emails are sent. Not shown to customers.
OWNER_EMAIL=toolsonthewheels@gmail.com
# The "From" address/name used on all outgoing emails. For SMTP this is usually the
# same mailbox you authenticate with.
EMAIL_FROM="Tools on the Wheels <toolsonthewheels@gmail.com>"
BUSINESS_NAME="Tools on the Wheels"
BUSINESS_PHONE="+1 (514) 571-9041"
# IANA timezone used to validate "preferred date" isn't in the past — keep this matching
# where the business actually operates, not wherever the server happens to be hosted.
BUSINESS_TIMEZONE=America/Toronto

# ---- Email provider selection ----
# Keep this as smtp for the PHP/shared-hosting deployment.
EMAIL_PROVIDER=smtp

# ---- SMTP (used when EMAIL_PROVIDER=smtp) ----
# Works with Gmail, Outlook/Office365, Zoho, or any SMTP-compatible provider —
# just change host/port/credentials, no code changes required.
#
# Gmail:    smtp.gmail.com        port 587 (STARTTLS) — use a 16-char App Password, not your real password
# Outlook:  smtp.office365.com    port 587 (STARTTLS)
# Zoho:     smtp.zoho.com         port 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password

# ---- Rate limiting (abuse protection on the booking endpoint) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5
